{
  "name": "leadfinder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --conditions=react-server src/worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.132",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-table": "8.21.3",
    "ai": "7.0.159",
    "better-auth": "1.7.14",
    "cheerio": "1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "geist": "1.7.0",
    "ipaddr.js": "2.5.0",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "1.65.0",
    "nanoid": "6.0.2",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "robots-parser": "3.0.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "pnpm": {

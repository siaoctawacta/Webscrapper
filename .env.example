# ─── Core ────────────────────────────────────────────────────────────────
APP_ENV=development
# Public base URL of the app (used for auth callbacks, share links, crawler User-Agent).
APP_URL=http://localhost:3000
DATABASE_URL=postgres://leadfinder:leadfinder@localhost:5432/leadfinder
# 32+ random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=<managed-secret>

# ─── Access control ─────────────────────────────────────────────────────
# approval: anyone can sign up, but an admin must approve them before they can use the app.
# invite:   only emails an admin has invited can sign up.
# closed:   no new sign-ups.
SIGNUP_MODE=approval
# Comma-separated emails that become admins automatically when they sign up.
ADMIN_EMAILS=

# ─── Data providers ─────────────────────────────────────────────────────
# Leave empty to run in "Sample data mode" (generated, clearly-labelled fake businesses).
GOOGLE_MAPS_API_KEY=<server-side-secret>
# Price you pay per 1,000 Text Search (Enterprise) requests, used for cost estimates only.
GOOGLE_TEXT_SEARCH_PRICE_PER_1000=35
GOOGLE_PLACE_DETAILS_PRICE_PER_1000=20
# How long full Google search results are kept for working with them before automatic deletion.
# Check this against your Google Maps Platform agreement.
GOOGLE_RESULTS_RETENTION_HOURS=24

# ─── AI (Vercel AI Gateway) ─────────────────────────────────────────────
# Leave empty to use built-in templates instead of AI for proposals and homepage concepts.
AI_GATEWAY_API_KEY=<managed-secret>
AI_MODEL=anthropic/claude-sonnet-5.5
AI_DAILY_LIMIT_PER_USER=50

# ─── Limits & cost controls ─────────────────────────────────────────────
MAX_RESULTS_PER_SEARCH=20000
MAX_SEARCH_JOBS_PER_USER_PER_DAY=50
MAX_CONCURRENT_JOBS_PER_USER=2
MAX_CONCURRENT_JOBS=4
# Searches whose estimated cost exceeds this need an explicit confirmation.
COST_CONFIRM_THRESHOLD_USD=5
# Hard monthly cap of billable provider requests per user (0 = unlimited).
MONTHLY_PROVIDER_REQUEST_LIMIT_PER_USER=5000

# ─── Website enrichment (email/contact discovery) ───────────────────────
CRAWL_CONCURRENCY=8
CRAWL_TIMEOUT_MS=10000
CRAWL_MAX_PAGES_PER_SITE=3

# ─── Exports ────────────────────────────────────────────────────────────
EXPORT_STORAGE_DIR=./storage/exports
EXPORT_LINK_TTL_MINUTES=15
